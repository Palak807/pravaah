{
  "name": "nabz",
  "version": "1.0.0",
  "private": true,
  "description": "Nabz — see today's beds before they jam. A bed-flow digital twin for small hospitals.",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @nabz/api dev",
    "dev:web": "pnpm --filter @nabz/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
