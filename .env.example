# Copy to .env and adjust. docker-compose reads this file.

# --- Postgres ---
POSTGRES_USER=nabz
POSTGRES_PASSWORD=nabz_dev_password
POSTGRES_DB=nabz
# Used by the API (inside docker-compose the host is "db")
DATABASE_URL=postgresql://nabz:nabz_dev_password@db:5432/nabz?schema=public

# --- API ---
API_PORT=3000
# One hospital for now; this seeds its display name.
HOSPITAL_NAME=Sunrise Nursing Home

# --- Assistant provider ---
# "scripted" (no model) or "model" (real LLM via the Anthropic API).
ASSISTANT_PROVIDER=model
# Required when ASSISTANT_PROVIDER=model. Keep this secret; never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Web (local dev / non-TLS compose) ---
WEB_PORT=8080

# --- Production (docker-compose.prod.yml, Caddy auto-HTTPS) ---
# Your domain, pointed at the server's IP via a DNS A record.
DOMAIN=
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=

# --- Contact form email (GoDaddy / Titan mailbox) ---
# Keep these secret; never commit real values.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@yourdomain.com
SMTP_PASS=
# Where contact-form messages are delivered (defaults to SMTP_USER if blank).
CONTACT_TO=hello@yourdomain.com
